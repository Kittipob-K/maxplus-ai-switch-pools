{
  "name": "maxplus-ai-switch-pools",
  "version": "0.1.0",
  "description": "CLI tool for switching AI pools based on selected models",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "maxplus-ai": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "cli",
    "ai",
    "pool",
    "switch"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@napi-rs/keyring": "^2.0.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
